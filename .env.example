# ─────────────────────────────────────────────────────────────────────────────────────────
# Scientific Club — server-side configuration (Cloud Functions only).
#
# Copy the plain settings to functions/.env (or functions/.env.<projectId>).
# SECRETS never go in a file that is committed or shipped to a client:
#   production → firebase functions:secrets:set NAME
#   emulator   → functions/.secret.local   (gitignored; see functions/.secret.local.example)
# ─────────────────────────────────────────────────────────────────────────────────────────

# Plain settings (functions/.env)
FUNCTIONS_REGION=europe-west1
PUBLIC_SITE_URL=https://your-club.example.org

# Email: "mock" logs instead of sending; "resend" uses https://resend.com
EMAIL_PROVIDER=mock
EMAIL_FROM="Scientific Club <tickets@your-domain.example>"

# WhatsApp: "mock" logs instead of sending; "meta" uses the official WhatsApp Cloud API
WHATSAPP_PROVIDER=mock
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TICKET_TEMPLATE=event_ticket
WHATSAPP_TEMPLATE_LANGUAGE=en

# Secrets (Secret Manager / functions/.secret.local) — names only, never real values here
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=            # whsec_… from the Resend webhook settings
# WHATSAPP_ACCESS_TOKEN=            # system-user token with whatsapp_business_messaging
# WHATSAPP_APP_SECRET=              # Meta app secret, verifies webhook signatures
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=    # any random string, repeated in the Meta webhook form
