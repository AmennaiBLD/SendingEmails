{
  "name": "scientific-club-functions",
  "private": true,
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && firebase emulators:exec --project demo-scientific-club --only firestore \"node --test --test-concurrency=1 lib/test/*.test.js\"",
    "seed": "npm run build && node lib/scripts/seed.js",
    "make-admin": "npm run build && node lib/scripts/makeAdmin.js",
    "init-project": "npm run build && node --env-file=.project.local lib/scripts/initProject.js",
    "migrate": "npm run build && node lib/scripts/migrateToClientWrites.js",
    "send-emails": "npm run build && node lib/scripts/sendEmails.js"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "nodemailer": "10.3.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.5",
    "firebase": "^13.3.0",
    "typescript": "~5.9.3"
  }
}
